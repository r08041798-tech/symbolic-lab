{"label":"Compound growth","slots":{"principal":"currency units","rate":"%","years":"years","periods":"per year","factor":"ratio","amount":"currency units","interest":"currency units"},"rules":[{"id":"compound.factor","output":"factor","inputs":["rate","years","periods"],"expr":{"op":"^","args":[{"op":"+","args":[1,{"op":"/","args":[{"ref":"rate"},{"op":"*","args":[100,{"ref":"periods"}]}]}]},{"op":"*","args":[{"ref":"years"},{"ref":"periods"}]}]},"formula":" (1 + rate ÷ (100 × periods)) ^ (years × periods)","cost":1,"weight":1},{"id":"compound.amount","output":"amount","inputs":["principal","factor"],"expr":{"op":"*","args":[{"ref":"principal"},{"ref":"factor"}]},"formula":"principal × growth factor","cost":1,"weight":1},{"id":"compound.interest","output":"interest","inputs":["amount","principal"],"expr":{"op":"-","args":[{"ref":"amount"},{"ref":"principal"}]},"formula":"final amount − principal","cost":1,"weight":1}],"assumptions":["Fixed interest rate and compounding frequency; no additional payments, fees, tax or withdrawals."]}